 *
 * Internal loopback (SPI_MODE_LOOP, see board .conf): no jumper needed.
 * The on-board SPI flash and its chip select are removed so the loopback
 * traffic can never address the flash (cs-gpios[0] is the flash CS, and a
 * 4th pinctrl pin would be used as hardware CS by the driver).
 */

/delete-node/ &mx25r80;

&spi0 {
	/delete-property/ cs-gpios;
	pinctrl-0 = <&spi0_sck_default
		     &spi0_mosi_default
		     &spi0_miso_default>;
	pinctrl-1 = <&spi0_sck_sleep
		     &spi0_mosi_sleep
		     &spi0_miso_sleep>;
	pinctrl-names = "default", "sleep";

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <4000000>;
	};
	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <8000000>;
	};
};
