 * Copyright (c) 2026 Texas Instruments Incorporated
 * SPDX-License-Identifier: Apache-2.0
 *
 * Standalone interrupt-driven UART loopback. Single-UART board: free uart0 by
 * moving the console to SEGGER RTT (run-test.sh injects rtt.conf), and use uart0
 * as the DUT. External loopback jumper: DIO20 (TXD) -> DIO22 (RXD).
 */

/ {
	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
	};
};

dut: &uart0 {
	status = "okay";
	current-speed = <115200>;
};
