 *
 * lp_em_cc2745r10_q1 (CC27xx): console/shell -> SEGGER RTT (injected rtt.conf),
 * uart0 is the DUT. Loopback jumper: DIO1 (uart0 TXD) -> DIO2 (uart0 RXD).
 */

/ {
	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
	};
};

dut: &uart0 {
	status = "okay";
	current-speed = <115200>;
};
