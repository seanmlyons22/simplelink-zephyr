 * SPDX-License-Identifier: Apache-2.0
 *
 * Device-PM smoke test for the LPF3 UART. Single-UART board: console moves to
 * SEGGER RTT (run-test.sh injects rtt.conf), uart0 is the DUT. Loopback jumper:
 * DIO20 (TXD) -> DIO22 (RXD), used to confirm data still flows after a
 * suspend/resume cycle reprograms the (non-retained) UART registers.
 */

/ {
	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
	};
};

dut: &uart0 {
	status = "okay";
	current-speed = <115200>;
};
