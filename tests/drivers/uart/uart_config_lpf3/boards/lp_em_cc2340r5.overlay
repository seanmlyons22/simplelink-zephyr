 * SPDX-License-Identifier: Apache-2.0
 *
 * Runtime line-config test for the LPF3 UART. Console -> SEGGER RTT (run-test.sh
 * injects rtt.conf), uart0 is the DUT. Loopback jumper: DIO20 (TXD) -> DIO22
 * (RXD): each configure() is checked by looping a byte back at that config.
 */

/ {
	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
	};
};

dut: &uart0 {
	status = "okay";
	current-speed = <115200>;
};
